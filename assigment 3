import java.util.*;

public class CampusPlanner {

    static class Building {
        int id; String name;
        Building(int id, String name){ this.id=id; this.name=name; }
        public String toString(){ return id + " " + name; }
    }

    static class BST {
        class Node{ Building b; Node l,r; Node(Building b){this.b=b;} }
        Node root;

        void insert(Building b){ root=ins(root,b); }
        Node ins(Node n, Building b){
            if(n==null) return new Node(b);
            if(b.id<n.b.id) n.l=ins(n.l,b);
            else n.r=ins(n.r,b);
            return n;
        }

        void inorder(){ in(root); }
        void in(Node n){
            if(n==null) return;
            in(n.l); System.out.println(n.b); in(n.r);
        }
    }

    static class AVL {
        class Node{ Building b; int h; Node l,r; Node(Building b){this.b=b;h=1;} }
        Node root;

        int H(Node n){ return n==null?0:n.h; }

        Node rotateR(Node y){
            Node x=y.l, t=x.r;
            x.r=y; y.l=t;
            y.h=1+Math.max(H(y.l),H(y.r));
            x.h=1+Math.max(H(x.l),H(x.r));
            return x;
        }
        Node rotateL(Node x){
            Node y=x.r, t=y.l;
            y.l=x; x.r=t;
            x.h=1+Math.max(H(x.l),H(x.r));
            y.h=1+Math.max(H(y.l),H(y.r));
            return y;
        }

        void insert(Building b){ root=ins(root,b); }
        Node ins(Node n, Building b){
            if(n==null) return new Node(b);
            if(b.id<n.b.id) n.l=ins(n.l,b);
            else n.r=ins(n.r,b);

            n.h=1+Math.max(H(n.l),H(n.r));
            int bf=H(n.l)-H(n.r);

            if(bf>1 && b.id<n.l.b.id) return rotateR(n);
            if(bf<-1 && b.id>n.r.b.id) return rotateL(n);
            if(bf>1 && b.id>n.l.b.id){ n.l=rotateL(n.l); return rotateR(n); }
            if(bf<-1 && b.id<n.r.b.id){ n.r=rotateR(n.r); return rotateL(n); }

            return n;
        }

        void inorder(){ in(root); }
        void in(Node n){
            if(n==null) return;
            in(n.l); System.out.println(n.b); in(n.r);
        }
    }

    static class Graph {
        Map<Integer,List<Integer>> g=new HashMap<>();

        void add(int v){ g.putIfAbsent(v,new ArrayList<>()); }
        void edge(int u,int v){
            g.get(u).add(v);
            g.get(v).add(u);
        }

        void bfs(int s){
            Queue<Integer> q=new LinkedList<>();
            Set<Integer> vis=new HashSet<>();
            q.add(s); vis.add(s);
            while(!q.isEmpty()){
                int x=q.poll();
                System.out.print(x+" ");
                for(int k:g.get(x))
                    if(!vis.contains(k)){
                        vis.add(k);
                        q.add(k);
                    }
            }
            System.out.println();
        }

        void dfs(int s){
            Set<Integer> vis=new HashSet<>();
            dfsR(s,vis);
            System.out.println();
        }

        void dfsR(int u, Set<Integer> vis){
            vis.add(u);
            System.out.print(u+" ");
            for(int k:g.get(u))
                if(!vis.contains(k)) dfsR(k,vis);
        }
    }

    static class ExprNode {
        String val; ExprNode l,r;
        ExprNode(String v){ val=v; }
    }

    static class ExpressionTree {
        ExprNode root;

        ExprNode build(String postfix){
            Stack<ExprNode> s=new Stack<>();
            for(String t: postfix.split(" ")){
                if("+-*/".contains(t)){
                    ExprNode n=new ExprNode(t);
                    n.r=s.pop();
                    n.l=s.pop();
                    s.push(n);
                } else s.push(new ExprNode(t));
            }
            return root=s.pop();
        }

        double eval(ExprNode n){
            if(n.l==null) return Double.parseDouble(n.val);
            double a=eval(n.l), b=eval(n.r);
            return switch(n.val){
                case "+"->a+b;
                case "-"->a-b;
                case "*"->a*b;
                default->a/b;
            };
        }
    }

    public static void main(String[] args) {

        BST bst=new BST();
        AVL avl=new AVL();
        Graph g=new Graph();

        Building b1=new Building(10,"Admin");
        Building b2=new Building(5,"Library");
        Building b3=new Building(20,"CSE");

        bst.insert(b1); bst.insert(b2); bst.insert(b3);
        avl.insert(b1); avl.insert(b2); avl.insert(b3);

        System.out.println("BST:");
        bst.inorder();

        System.out.println("\nAVL:");
        avl.inorder();

        g.add(10); g.add(5); g.add(20);
        g.edge(10,5);
        g.edge(10,20);

        System.out.println("\nBFS:");
        g.bfs(10);

        System.out.println("DFS:");
        g.dfs(10);

        ExpressionTree et=new ExpressionTree();
        et.build("5 3 + 2 *");
        System.out.println("\nExpression Value: "+et.eval(et.root));
    }
}
